# ==============================================================================
# TATVIK - Environment Configuration Template
# ==============================================================================
# Duplicate this file as '.env' in your local environment.
# NEVER commit the actual '.env' file or any confidential keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # options: development, staging, production
DEBUG=true
APP_NAME=TATVIK
SECRET_KEY=replace_with_a_secure_random_64_char_secret_key
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Backend API (FastAPI / Python)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# Frontend Application (React / TypeScript / Vite)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=TATVIK

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=tatvik_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=tatvik_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tatvik_user:your_secure_postgres_password_here@localhost:5432/tatvik_db

# ------------------------------------------------------------------------------
# Redis & Asynchronous Task Processing (Celery / Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ------------------------------------------------------------------------------
# File Storage (Raw & Cleaned Datasets)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local                 # options: local, s3, minio
LOCAL_STORAGE_PATH=./storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=your_s3_access_key_placeholder
S3_SECRET_ACCESS_KEY=your_s3_secret_key_placeholder
S3_BUCKET_NAME=tatvik-datasets
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# AI & Verification Engine (LLM API Keys)
# ------------------------------------------------------------------------------
# Configure one or more LLM providers for data anomaly detection & verification
OPENAI_API_KEY=your_openai_api_key_placeholder
ANTHROPIC_API_KEY=your_anthropic_api_key_placeholder
GEMINI_API_KEY=your_gemini_api_key_placeholder
DEFAULT_LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# ------------------------------------------------------------------------------
# Authentication & JWT Security
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=replace_with_jwt_secret_signing_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# TATVIK Backend - Environment Configuration Template (Phase 1)
# ==============================================================================
# Copy this file to .env before starting the development server.
# Do not commit real credentials or keys to version control.
# ==============================================================================

APP_NAME=TATVIK API
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated origins for local development)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Research Verification Provider (Part 5)
# Supported options: none, tavily, serpapi, mock
RESEARCH_PROVIDER=none
TAVILY_API_KEY=your_tavily_api_key_placeholder
SERPAPI_API_KEY=your_serpapi_api_key_placeholder
RESEARCH_TIMEOUT_SECONDS=10
RESEARCH_MAX_CLAIMS_PER_BATCH=20

# Database & Persistent Storage (Part 6)
# SQLite for local testing, or Supabase PostgreSQL connection string
DATABASE_URL=sqlite:///./tatvik.db
STORAGE_DIR=./storage/uploads

# Supabase Authentication & Project Configuration (Part 6)
# Obtain from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
# Backend only secret (never expose in frontend code):
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder


# ==============================================================================
# TATVIK - Root .gitignore (React / TypeScript Frontend + Python Backend)
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & IDE Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Environment Variables, Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
*.p12
id_rsa*
secrets/
credentials.json

# ------------------------------------------------------------------------------
# Data Files, Datasets & Private Business Uploads
# ------------------------------------------------------------------------------
*.csv
*.tsv
*.xlsx
*.xls
*.xlsm
*.parquet
*.jsonl
*.sqlite
*.sqlite3
*.db
/uploads/
/exports/
/storage/
/datasets/
data/*
!data/.gitkeep

# ------------------------------------------------------------------------------
# Python Backend
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
.python-version

# Testing, Coverage & Linters
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/
.nox/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# Celery & Background Workers
celerybeat-schedule
celerybeat.pid

# ------------------------------------------------------------------------------
# React / TypeScript Frontend & Node.js
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
.pnp/
.pnp.js

# Build Outputs & Bundles
frontend/dist/
frontend/build/
dist/
build/
out/
.next/
.nuxt/
.vite/
.parcel-cache/

# Node Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# Cache & Build Tools
.eslintcache
.stylelintcache
.prettiercache
.tsbuildinfo
.turbo/
